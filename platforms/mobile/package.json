{
  "name": "api-tracker-mobile",
  "version": "1.0.0",
  "description": "API Usage Tracker - Mobile App",
  "main": "www/index.html",
  "scripts": {
    "build": "node build-mobile.js",
    "start": "npx serve www",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/browser": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "@capacitor/preferences": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "serve": "^14.0.0"
  }
}
