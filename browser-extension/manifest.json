{
  "manifest_version": 2,
  "name": "API Usage Scraper",
  "version": "1.0.0",
  "description": "Scrapes usage data from AI provider dashboards for API Tracker",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "*://console.anthropic.com/*",
    "*://platform.openai.com/*",
    "*://github.com/*",
    "*://console.cloud.google.com/*",
    "*://www.perplexity.ai/*",
    "*://claude.ai/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://console.anthropic.com/*"],
      "js": ["scrapers/anthropic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://platform.openai.com/*"],
      "js": ["scrapers/openai.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://github.com/settings/billing/*"],
      "js": ["scrapers/github-copilot.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://claude.ai/settings*"],
      "js": ["scrapers/claude-ai.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://console.cloud.google.com/*"],
      "js": ["scrapers/google-cloud.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.perplexity.ai/settings/*"],
      "js": ["scrapers/perplexity.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
